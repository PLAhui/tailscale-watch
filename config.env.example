# 复制为 config.env 后按自己的网络填写；config.env 已被 .gitignore 排除
# cp config.env.example config.env

# 对端设备（必填）：Tailscale 100.x 地址或 MagicDNS 名
PEER_HOST=100.64.0.2
# 对端设备在界面上的显示名
PEER_NAME=mac-mini

# 本机显示名（留空 = 系统 hostname）
SELF_NAME=

# 国内出口基准目标（默认阿里 DNS）
ALI_HOST=223.5.5.5

# 采样拿不到网关 IP 时的兜底显示（可留空）
GATEWAY_FALLBACK=192.168.1.1
