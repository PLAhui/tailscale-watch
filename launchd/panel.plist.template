<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板：scripts/install-launchd.sh 会把 __PROJECT_DIR__ 替换成本仓库的绝对路径 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.tailscale-watch.panel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__PROJECT_DIR__/app/server.py</string>
        <string>8767</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/var/panel.out</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/var/panel.err</string>
</dict>
</plist>
