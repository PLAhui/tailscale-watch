<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板：scripts/install-launchd.sh 会把 __PROJECT_DIR__ 替换成本仓库的绝对路径 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.tailscale-watch.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/netcheck-watch.sh</string>
        <string>--once</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/var/agent.out</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/var/agent.err</string>
</dict>
</plist>
